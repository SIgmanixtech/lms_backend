# -----------------------------------------------------------------------------
# Next.js backend (backend/). ALL values are SERVER_ONLY: set them in the backend
# host's secret store (e.g. Vercel project env). Never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Supabase (database, auth, storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call this API (exact match, comma separated, no trailing slash).
# Example: https://lms.yourdomain.in,https://learning-journey-hub.lovable.app
# Outside production, http://localhost:8080 is also allowed for local dev.
ALLOWED_ORIGINS=

# Public URL of THIS backend, used to build recording stream links, e.g. https://api.lms.yourdomain.in
PUBLIC_API_URL=

# Public site address used in email/push links, e.g. https://lms.yourdomain.in
PUBLIC_APP_URL=

# One-time first admin bootstrap (POST /api/public/bootstrap-admin, header x-bootstrap-token)
ADMIN_BOOTSTRAP_TOKEN=

# Scheduler bearer secret for /api/public/cron/deliver-notifications
CRON_SECRET=
LOVABLE_CRON_SECRET=

# Email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Firebase: service account JSON for sending push, and the public Web API key handed to signed-in users
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_API_KEY=

# Zoho Meeting (online classes, attendance, recordings)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_PRESENTER_ID=
ZOHO_ACCOUNTS_BASE_URL=
ZOHO_API_BASE_URL=
